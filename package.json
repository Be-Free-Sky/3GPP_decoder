{
  "name": "skyworth-3gpp-decoder",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "engine": "node scripts/build-engine.mjs",
    "build": "node scripts/build-engine.mjs --if-missing && vite build",
    "dev": "node scripts/build-engine.mjs --if-missing && vite",
    "test": "node tests/e2e.mjs",
